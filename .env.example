# Password untuk masuk ke website (bebas, buat yang kuat)
APP_PASSWORD=

# Postgres (Neon / Supabase / Vercel Postgres) — connection string
DATABASE_URL=

# Long-lived access token Threads (lihat README langkah 2). Setelah dipakai, token
# di-refresh otomatis dan disimpan di database.
THREADS_ACCESS_TOKEN=

# Isi 1 untuk mencoba website dengan data contoh tanpa akses API Threads
THREADS_MOCK=0

# Kunci API Claude untuk kurasi AI (kosongkan kalau hanya mau filter aturan)
ANTHROPIC_API_KEY=
# Opsional: ganti model. Default claude-haiku-5-5 (murah & cepat)
AI_MODEL=

# String acak panjang; Vercel Cron mengirimnya otomatis sebagai header Authorization
CRON_SECRET=
